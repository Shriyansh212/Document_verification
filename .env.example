# Application
APP_NAME="Document Verification Pipeline"
APP_ENV=development
DEBUG=true

# Database (SQLite by default; supports PostgreSQL e.g. postgresql+psycopg2://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./data/verification.db

# Groq Llama LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tesseract OCR (optional on Windows if tesseract is not in PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Upload limits
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
